{
  "name": "immiscible",
  "version": "0.1.1",
  "description": "Approvals, spend limits and a kill switch for AI agents, set up in one command: npx immiscible init. Installs a fail-closed Claude Code hook, prints MCP setup for Claude Code, Cursor and VS Code, and runs non-interactively for AI coding agents (--json, exit codes). Zero dependencies.",
  "license": "MIT",
  "author": "Eóin Forker",
  "homepage": "https://immiscible.fly.dev",
