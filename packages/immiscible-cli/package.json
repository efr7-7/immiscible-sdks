    "type": "git",
    "url": "git+https://github.com/efr7-7/immiscible-sdks.git",
    "directory": "packages/immiscible-cli"
  },
  "bugs": {
    "url": "https://github.com/efr7-7/immiscible-sdks/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "immiscible": "./bin/immiscible.mjs"
  },
  "files": [
    "bin",
    "src",
    "hook",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "node scripts/sync-hook.mjs",
    "prepack": "node scripts/sync-hook.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\""
  },
