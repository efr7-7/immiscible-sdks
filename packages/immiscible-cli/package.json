{
  "name": "immiscible",
  "version": "0.3.0",
  "description": "What your coding agents did, and a guard in front of them, in one command: npx immiscible scan, then npx immiscible guard. Works with Claude Code, Codex, Cursor, Windsurf, Gemini CLI, Factory Droid, opencode and Amp, locally with no account; share with your team for one set of rules across every machine. Also: approvals, spend limits and signed receipts for any agent (npx immiscible init). Zero dependencies.",
  "license": "MIT",
  "author": "Eóin Forker",
  "homepage": "https://immiscible.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efr7-7/immiscible-sdks.git",
    "directory": "packages/immiscible-cli"
  },
  "bugs": {
    "url": "https://github.com/efr7-7/immiscible-sdks/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "immiscible": "./bin/immiscible.mjs"
  },
  "files": [
    "bin",
    "src",
    "hook",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync": "node scripts/sync-hook.mjs && node scripts/sync-vendor.mjs",
    "prepack": "node scripts/sync-hook.mjs && node scripts/sync-vendor.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.mjs\""
  },
  "keywords": [
