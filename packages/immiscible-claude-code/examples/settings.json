{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|WebFetch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node /path/to/immiscible/packages/immiscible-claude-code/bin/immiscible-claude-code-hook.mjs || exit 2",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "env": {
    "IMMISCIBLE_URL": "https://immiscible.example",
    "ANTHROPIC_BASE_URL": "https://immiscible.example/anthropic"
  }
}
